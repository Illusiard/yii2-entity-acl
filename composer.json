{
    "name": "illusiard/yii2-entity-acl",
    "description": "Unix-like ACL + JSON conditions (allow/deny) for entities and records in Yii2",
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "autoload": {
        "psr-4": {
            "illusiard\\entity_acl\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Illusiard"
        }
    ],
    "require": {
        "php": ">=8.5",
        "yiisoft/yii2": "^2.0.55"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "autoload-dev": {
        "psr-4": {
            "illusiard\\entity_acl\\tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
